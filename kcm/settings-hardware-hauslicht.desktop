[Desktop Entry]
# System Settings (Plasma 6): the category "Haus.Licht" under Hardware, which
# lists the five KCMs (kcm_hauslicht_*, X-KDE-System-Settings-Parent-Category
# = hauslicht). System Settings hides a category without modules.
Type=Service
X-KDE-ServiceTypes=SystemSettingsCategory
X-KDE-System-Settings-Category=hauslicht
X-KDE-System-Settings-Parent-Category=hardware
X-KDE-Weight=90
Icon=brightness-high
Name=Haus.Licht
Comment=Bulbs that follow the screen: bulbs, profiles, sound, video, notifications
Comment[de]=Lampen, die dem Bildschirm folgen: Lampen, Profile, Ton, Video, Benachrichtigungen
X-KDE-Keywords=light,lights,bulb,lamp,smart bulb,Haus.Licht
X-KDE-Keywords[de]=Licht,Lampe,Lampen,Glühbirne,smarte Lampe,Haus.Licht
